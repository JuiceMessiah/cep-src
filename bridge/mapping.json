{
  "_comment": "What the bridge does per CEP alert type, and which BPMN jobs report back to the CEP. See CONTRACT.md sections 5 and 6. The SmokeTest entries drive bpmn/cep-smoke-test.bpmn (plumbing test only); the real models get their own entries next to them. TEMPORARY: FireAlert and SceneCleared are mapped onto the smoke-test process too (SmokeStart / FireUpdate) so the chain can be demonstrated end to end until bpmn ambulance_fire_response exists; replace them with the target entries in CONTRACT.md section 6 then. Activity names must match the element names in the models: they become the XES activities used for conformance checking.",
  "on_alert": {
    "SmokeTest": [
      {
        "engine": "zeebe",
        "action": "correlate_message",
        "message": "SmokeStart",
        "process_id": "cep_smoke_test",
        "log_activity": "Fire risk detected"
      },
      {
        "engine": "dcr",
        "action": "start_case",
        "event_id": "ReportFire",
        "log_activity": ""
      }
    ],
    "SmokeTestUpdate": [
      {
        "engine": "zeebe",
        "action": "publish_message",
        "message": "FireUpdate",
        "ttl_s": 60,
        "process_id": "cep_smoke_test",
        "log_activity": "Fire update received"
      },
      {
        "engine": "dcr",
        "action": "execute",
        "event_id": "Escalate",
        "create_if_missing": false
      }
    ],
    "FireAlert": [
      {
        "engine": "zeebe",
        "action": "correlate_message",
        "message": "SmokeStart",
        "process_id": "cep_smoke_test",
        "log_activity": "Fire risk detected"
      }
    ],
    "SceneCleared": [
      {
        "engine": "zeebe",
        "action": "publish_message",
        "message": "FireUpdate",
        "ttl_s": 60,
        "process_id": "cep_smoke_test",
        "log_activity": "Fire update received"
      }
    ]
  },
  "zeebe_tasks": {
    "cep-event": {
      "activity_from_header": "activity",
      "variables": ["unitId"],
      "emit": true
    },
    "close-incident": {
      "activity": "Close incident",
      "variables": ["priority"],
      "emit": true,
      "set": {
        "closedBy": "bridge"
      }
    }
  },
  "dcr_watch": {
    "poll_s": 5,
    "events": []
  }
}
