{
  "_comment": "What the bridge does per CEP alert type, and which BPMN jobs report back to the CEP. See CONTRACT.md sections 5 and 6. FireAlert/SceneCleared/CapacityRedirect drive bpmn/ambulance_fire_response.bpmn (process Ambulance_process); BurnSupplyEmergency drives the DCR purchasing graph (event id to fill in once the graph is on dcrgraphs.net: tools/dcr_probe.py prints it). The SmokeTest entries drive bpmn/cep-smoke-test.bpmn (plumbing test). Activity names must match the element names in the models: they become the XES activities used for conformance checking.",
  "on_alert": {
    "SmokeTest": [
      {
        "engine": "zeebe",
        "action": "correlate_message",
        "message": "SmokeStart",
        "process_id": "cep_smoke_test",
        "log_activity": "Fire risk detected"
      },
      {
        "engine": "dcr",
        "action": "start_case",
        "event_id": "ReportFire",
        "log_activity": ""
      }
    ],
    "SmokeTestUpdate": [
      {
        "engine": "zeebe",
        "action": "publish_message",
        "message": "FireUpdate",
        "ttl_s": 60,
        "process_id": "cep_smoke_test",
        "log_activity": "Fire update received"
      },
      {
        "engine": "dcr",
        "action": "execute",
        "event_id": "Escalate",
        "create_if_missing": false
      }
    ],
    "FireAlert": [
      {
        "engine": "zeebe",
        "action": "correlate_message",
        "message": "FireAlert",
        "process_id": "Ambulance_process",
        "log_activity": "Major fire alert received"
      }
    ],
    "SceneCleared": [
      {
        "engine": "zeebe",
        "action": "publish_message",
        "message": "SceneCleared",
        "ttl_s": 86400,
        "process_id": "Ambulance_process",
        "log_activity": "Await scene cleared"
      }
    ],
    "CapacityRedirect": [
      {
        "engine": "zeebe",
        "action": "publish_message",
        "message": "DestinationChanged",
        "correlation_key": "{case_key}|{details.unit_id}",
        "ttl_s": 0,
        "process_id": "Ambulance_process",
        "log_activity": "Destination changed"
      }
    ],
    "BurnSupplyEmergency": [
      {
        "engine": "dcr",
        "action": "start_case",
        "event_id": "SET_ME_DeclareEmergencyProcurement",
        "log_activity": ""
      }
    ]
  },
  "zeebe_tasks": {
    "cep-event": {
      "activity_from_header": "activity",
      "variables": [
        "unitId"
      ],
      "emit": true
    },
    "close-incident": {
      "activity": "Close incident",
      "variables": [
        "priority"
      ],
      "emit": true,
      "set": {
        "closedBy": "bridge"
      }
    },
    "check-unit-availability": {
      "activity": "Check unit availability",
      "emit": false,
      "set": {
        "unitsAvailable": 1
      }
    }
  },
  "dcr_watch": {
    "poll_s": 5,
    "events": []
  },
  "camunda_log": {
    "poll_s": 5
  }
}
