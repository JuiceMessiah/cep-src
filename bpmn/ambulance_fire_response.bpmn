<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Defs" targetNamespace="http://bpmn.io/schema/bpmn" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.8.0">
  <bpmn:message id="Msg_FireAlert" name="FireAlert" />
  <bpmn:message id="Msg_DestinationChanged" name="DestinationChanged">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=caseKey + &quot;|&quot; + unitId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Msg_SceneCleared" name="SceneCleared">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=caseKey" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:collaboration id="C">
    <bpmn:participant id="P_main" name="Regional emergency medical dispatch (AMK)" processRef="Ambulance_process" />
    <bpmn:participant id="P_CEP" name="CEP engine (Siddhi / Flink)" />
    <bpmn:participant id="P_ED" name="Receiving hospital ED (fire triage process)" />
    <bpmn:participant id="P_IC" name="Fire service incident command" />
    <bpmn:messageFlow id="m1" name="Fire alert detected" sourceRef="P_CEP" targetRef="S1" />
    <bpmn:messageFlow id="m2" name="Unit status events" sourceRef="T_availrep" targetRef="P_CEP" />
    <bpmn:messageFlow id="m3" name="Capacity redirect" sourceRef="P_CEP" targetRef="B2" />
    <bpmn:messageFlow id="m4" name="MCI notification" sourceRef="T_mci" targetRef="P_ED" />
    <bpmn:messageFlow id="m5" name="EMS pre-alert" sourceRef="T_prealert" targetRef="P_ED" />
    <bpmn:messageFlow id="m6" name="Patient handover" sourceRef="T_handover" targetRef="P_ED" />
    <bpmn:messageFlow id="m7" name="Arrival report" sourceRef="T_report" targetRef="P_IC" />
    <bpmn:messageFlow id="m8" name="Scene cleared" sourceRef="P_IC" targetRef="T_cleared" />
  </bpmn:collaboration>
  <bpmn:process id="Ambulance_process" name="Ambulance response to major fire" isExecutable="true">
    <bpmn:laneSet id="LS">
      <bpmn:lane id="L_disp" name="Dispatcher">
        <bpmn:flowNodeRef>S1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_assess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_mci</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_units</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_avail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_aid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_cleared</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_close</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_crew" name="Ambulance crew">
        <bpmn:flowNodeRef>SP</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S1" name="Major fire alert received">
      <bpmn:outgoing>f1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="S1_def" messageRef="Msg_FireAlert" />
    </bpmn:startEvent>
    <bpmn:userTask id="T_assess" name="Assess incident">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G1" name="Mass casualty incident?" default="f4">
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
      <bpmn:outgoing>f4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="T_mci" name="Activate MCI protocol">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="cep-event" />
        <zeebe:taskHeaders>
          <zeebe:header key="activity" value="Activate MCI protocol" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f5</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="G2" name="">
      <bpmn:incoming>f4</bpmn:incoming>
      <bpmn:incoming>f5</bpmn:incoming>
      <bpmn:outgoing>f6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:businessRuleTask id="T_units" name="Determine units needed">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="determine_units" resultVariable="unitsNeeded" />
      </bpmn:extensionElements>
      <bpmn:incoming>f6</bpmn:incoming>
      <bpmn:outgoing>f7</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:serviceTask id="T_avail" name="Check unit availability">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="check-unit-availability" />
      </bpmn:extensionElements>
      <bpmn:incoming>f7</bpmn:incoming>
      <bpmn:outgoing>f8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G3" name="Enough units?" default="f10">
      <bpmn:incoming>f8</bpmn:incoming>
      <bpmn:outgoing>f9</bpmn:outgoing>
      <bpmn:outgoing>f10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="T_aid" name="Request units from neighbouring region">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="cep-event" />
        <zeebe:taskHeaders>
          <zeebe:header key="activity" value="Request units from neighbouring region" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>f9</bpmn:incoming>
      <bpmn:outgoing>f11</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="G4" name="">
      <bpmn:incoming>f10</bpmn:incoming>
      <bpmn:incoming>f11</bpmn:incoming>
      <bpmn:outgoing>f12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:subProcess id="SP" name="Ambulance mission (one per unit)">
      <bpmn:incoming>f12</bpmn:incoming>
      <bpmn:outgoing>f13</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics isSequential="false">
        <bpmn:extensionElements>
          <zeebe:loopCharacteristics inputCollection="=for i in 1..unitsNeeded return &quot;amb-&quot; + string(i)" inputElement="unitId" />
        </bpmn:extensionElements>
      </bpmn:multiInstanceLoopCharacteristics>
      <bpmn:startEvent id="S2" name="Unit dispatched">
        <bpmn:outgoing>s1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="T_kit" name="Verify burn kit">
        <bpmn:extensionElements>
          <zeebe:userTask />
        </bpmn:extensionElements>
        <bpmn:incoming>s1</bpmn:incoming>
        <bpmn:outgoing>s2</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="G5" name="">
        <bpmn:incoming>s2</bpmn:incoming>
        <bpmn:incoming>s13</bpmn:incoming>
        <bpmn:outgoing>s3</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="T_drive" name="Drive to scene">
        <bpmn:extensionElements>
          <zeebe:userTask />
        </bpmn:extensionElements>
        <bpmn:incoming>s3</bpmn:incoming>
        <bpmn:outgoing>s4</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:boundaryEvent id="B1" name="Response target exceeded" attachedToRef="T_drive" cancelActivity="false">
        <bpmn:outgoing>s15</bpmn:outgoing>
        <bpmn:timerEventDefinition id="B1_def">
          <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT8M</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:boundaryEvent>
      <bpmn:sendTask id="T_delay" name="Notify dispatcher of delay">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="cep-event" />
          <zeebe:taskHeaders>
            <zeebe:header key="activity" value="Notify dispatcher of delay" />
          </zeebe:taskHeaders>
        </bpmn:extensionElements>
        <bpmn:incoming>s15</bpmn:incoming>
        <bpmn:outgoing>s16</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:endEvent id="E_delay" name="">
        <bpmn:incoming>s16</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:userTask id="T_report" name="Report to incident commander">
        <bpmn:extensionElements>
          <zeebe:userTask />
        </bpmn:extensionElements>
        <bpmn:incoming>s4</bpmn:incoming>
        <bpmn:outgoing>s5</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="T_triage" name="Field triage and burn care">
        <bpmn:extensionElements>
          <zeebe:userTask />
        </bpmn:extensionElements>
        <bpmn:incoming>s5</bpmn:incoming>
        <bpmn:outgoing>s6</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:businessRuleTask id="T_dest" name="Select destination hospital">
        <bpmn:extensionElements>
          <zeebe:calledDecision decisionId="select_destination" resultVariable="destination" />
        </bpmn:extensionElements>
        <bpmn:incoming>s6</bpmn:incoming>
        <bpmn:outgoing>s7</bpmn:outgoing>
      </bpmn:businessRuleTask>
      <bpmn:sendTask id="T_prealert" name="Send EMS pre-alert">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="cep-event" />
          <zeebe:taskHeaders>
            <zeebe:header key="activity" value="Send EMS pre-alert" />
          </zeebe:taskHeaders>
        </bpmn:extensionElements>
        <bpmn:incoming>s7</bpmn:incoming>
        <bpmn:incoming>s18</bpmn:incoming>
        <bpmn:outgoing>s8</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:userTask id="T_transport" name="Transport patient">
        <bpmn:extensionElements>
          <zeebe:userTask />
        </bpmn:extensionElements>
        <bpmn:incoming>s8</bpmn:incoming>
        <bpmn:outgoing>s9</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:boundaryEvent id="B2" name="Destination changed" attachedToRef="T_transport" cancelActivity="true">
        <bpmn:outgoing>s17</bpmn:outgoing>
        <bpmn:messageEventDefinition id="B2_def" messageRef="Msg_DestinationChanged" />
      </bpmn:boundaryEvent>
      <bpmn:userTask id="T_update" name="Update destination">
        <bpmn:extensionElements>
          <zeebe:userTask />
        </bpmn:extensionElements>
        <bpmn:incoming>s17</bpmn:incoming>
        <bpmn:outgoing>s18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="T_handover" name="Hand over patient at ED">
        <bpmn:extensionElements>
          <zeebe:userTask />
        </bpmn:extensionElements>
        <bpmn:incoming>s9</bpmn:incoming>
        <bpmn:outgoing>s10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="T_restock" name="Clean, decontaminate and restock">
        <bpmn:extensionElements>
          <zeebe:userTask />
        </bpmn:extensionElements>
        <bpmn:incoming>s10</bpmn:incoming>
        <bpmn:outgoing>s11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="G6" name="More patients at scene?" default="s12">
        <bpmn:incoming>s11</bpmn:incoming>
        <bpmn:outgoing>s12</bpmn:outgoing>
        <bpmn:outgoing>s13</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sendTask id="T_availrep" name="Report unit available">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="cep-event" />
          <zeebe:taskHeaders>
            <zeebe:header key="activity" value="Report unit available" />
          </zeebe:taskHeaders>
        </bpmn:extensionElements>
        <bpmn:incoming>s12</bpmn:incoming>
        <bpmn:outgoing>s14</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:endEvent id="E2" name="Mission complete">
        <bpmn:incoming>s14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="s1" name="" sourceRef="S2" targetRef="T_kit" />
      <bpmn:sequenceFlow id="s2" name="" sourceRef="T_kit" targetRef="G5" />
      <bpmn:sequenceFlow id="s3" name="" sourceRef="G5" targetRef="T_drive" />
      <bpmn:sequenceFlow id="s4" name="" sourceRef="T_drive" targetRef="T_report" />
      <bpmn:sequenceFlow id="s5" name="" sourceRef="T_report" targetRef="T_triage" />
      <bpmn:sequenceFlow id="s6" name="" sourceRef="T_triage" targetRef="T_dest" />
      <bpmn:sequenceFlow id="s7" name="" sourceRef="T_dest" targetRef="T_prealert" />
      <bpmn:sequenceFlow id="s8" name="" sourceRef="T_prealert" targetRef="T_transport" />
      <bpmn:sequenceFlow id="s9" name="" sourceRef="T_transport" targetRef="T_handover" />
      <bpmn:sequenceFlow id="s10" name="" sourceRef="T_handover" targetRef="T_restock" />
      <bpmn:sequenceFlow id="s11" name="" sourceRef="T_restock" targetRef="G6" />
      <bpmn:sequenceFlow id="s12" name="No" sourceRef="G6" targetRef="T_availrep" />
      <bpmn:sequenceFlow id="s13" name="Yes" sourceRef="G6" targetRef="G5">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=is defined(morePatients) and morePatients = true</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="s14" name="" sourceRef="T_availrep" targetRef="E2" />
      <bpmn:sequenceFlow id="s15" name="" sourceRef="B1" targetRef="T_delay" />
      <bpmn:sequenceFlow id="s16" name="" sourceRef="T_delay" targetRef="E_delay" />
      <bpmn:sequenceFlow id="s17" name="" sourceRef="B2" targetRef="T_update" />
      <bpmn:sequenceFlow id="s18" name="" sourceRef="T_update" targetRef="T_prealert" />
    </bpmn:subProcess>
    <bpmn:receiveTask id="T_cleared" name="Await scene cleared" messageRef="Msg_SceneCleared">
      <bpmn:incoming>f13</bpmn:incoming>
      <bpmn:outgoing>f14</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:userTask id="T_close" name="Close incident and log response times">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>f14</bpmn:incoming>
      <bpmn:outgoing>f15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="E3" name="Incident closed">
      <bpmn:incoming>f15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" name="" sourceRef="S1" targetRef="T_assess" />
    <bpmn:sequenceFlow id="f2" name="" sourceRef="T_assess" targetRef="G1" />
    <bpmn:sequenceFlow id="f3" name="Yes" sourceRef="G1" targetRef="T_mci">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=alert.details.danger_class &gt;= 4 or alert.details.detections &gt;= 10</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f4" name="No" sourceRef="G1" targetRef="G2" />
    <bpmn:sequenceFlow id="f5" name="" sourceRef="T_mci" targetRef="G2" />
    <bpmn:sequenceFlow id="f6" name="" sourceRef="G2" targetRef="T_units" />
    <bpmn:sequenceFlow id="f7" name="" sourceRef="T_units" targetRef="T_avail" />
    <bpmn:sequenceFlow id="f8" name="" sourceRef="T_avail" targetRef="G3" />
    <bpmn:sequenceFlow id="f9" name="No" sourceRef="G3" targetRef="T_aid">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=unitsAvailable &lt; unitsNeeded</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f10" name="Yes" sourceRef="G3" targetRef="G4" />
    <bpmn:sequenceFlow id="f11" name="" sourceRef="T_aid" targetRef="G4" />
    <bpmn:sequenceFlow id="f12" name="" sourceRef="G4" targetRef="SP" />
    <bpmn:sequenceFlow id="f13" name="" sourceRef="SP" targetRef="T_cleared" />
    <bpmn:sequenceFlow id="f14" name="" sourceRef="T_cleared" targetRef="T_close" />
    <bpmn:sequenceFlow id="f15" name="" sourceRef="T_close" targetRef="E3" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="D">
    <bpmndi:BPMNPlane id="PL" bpmnElement="C">
      <bpmndi:BPMNShape id="P_main_di" bpmnElement="P_main" isHorizontal="true">
        <dc:Bounds x="160" y="200" width="3640" height="800" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L_disp_di" bpmnElement="L_disp" isHorizontal="true">
        <dc:Bounds x="190" y="200" width="3610" height="260" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L_crew_di" bpmnElement="L_crew" isHorizontal="true">
        <dc:Bounds x="190" y="460" width="3610" height="540" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P_CEP_di" bpmnElement="P_CEP" isHorizontal="true">
        <dc:Bounds x="160" y="40" width="3640" height="100" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P_ED_di" bpmnElement="P_ED" isHorizontal="true">
        <dc:Bounds x="160" y="1060" width="3640" height="100" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P_IC_di" bpmnElement="P_IC" isHorizontal="true">
        <dc:Bounds x="160" y="1200" width="3640" height="100" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S1_di" bpmnElement="S1">
        <dc:Bounds x="222" y="282" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="182" y="324" width="116" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_assess_di" bpmnElement="T_assess">
        <dc:Bounds x="300" y="260" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G1_di" bpmnElement="G1">
        <dc:Bounds x="450" y="275" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="410" y="237" width="130" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_mci_di" bpmnElement="T_mci">
        <dc:Bounds x="540" y="360" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G2_di" bpmnElement="G2">
        <dc:Bounds x="690" y="275" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_units_di" bpmnElement="T_units">
        <dc:Bounds x="790" y="260" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_avail_di" bpmnElement="T_avail">
        <dc:Bounds x="940" y="260" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G3_di" bpmnElement="G3">
        <dc:Bounds x="1090" y="275" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1050" y="237" width="130" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_aid_di" bpmnElement="T_aid">
        <dc:Bounds x="1180" y="360" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G4_di" bpmnElement="G4">
        <dc:Bounds x="1330" y="275" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SP_di" bpmnElement="SP" isExpanded="true">
        <dc:Bounds x="1420" y="490" width="1900" height="480" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_cleared_di" bpmnElement="T_cleared">
        <dc:Bounds x="3370" y="260" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_close_di" bpmnElement="T_close">
        <dc:Bounds x="3520" y="260" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E3_di" bpmnElement="E3">
        <dc:Bounds x="3702" y="282" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="3662" y="324" width="116" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S2_di" bpmnElement="S2">
        <dc:Bounds x="1452" y="702" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1430" y="744" width="80" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_kit_di" bpmnElement="T_kit">
        <dc:Bounds x="1530" y="680" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G5_di" bpmnElement="G5">
        <dc:Bounds x="1680" y="695" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_drive_di" bpmnElement="T_drive">
        <dc:Bounds x="1780" y="680" width="100" height="80" />
      </bpmndi:BPMNShape>
